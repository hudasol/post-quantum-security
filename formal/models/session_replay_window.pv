(* Model session_replay_window. Generated by formal/build_models.py; do not edit by hand.
   Design: command layer only (abstract session key, as in session_timestamp_rule): bounded window rule, W = 2: accept counter t if the tag is valid, t is greater than the highest accepted counter minus W, and t was not accepted before; the vehicle reads command messages one after the other and keeps its state in process variables; the seen counter restriction of session_replay_cache is added and holds on every trace of this process; 4 commands per key, at most 4 command messages read per key at the vehicle (attacker messages included), one key per session, unbounded sessions
   Attacker setting: Dolev Yao attacker, no secret given *)
free c: channel.
type key.
type stamp.
fun mac(bitstring, key): bitstring.
const tCmd: bitstring [data].
table seen(bitstring, nat).
event VKey(bitstring, key).
event Send(bitstring, nat, bitstring).
event Acc(bitstring, nat, bitstring).
event Mark(bitstring, nat, stamp).
event Late(bitstring, nat, nat).

(* Seen counter table, encoded as a restriction on traces (see formal/build_models.py). *)
restriction s: bitstring, t: nat, a: stamp, b: stamp; event(Mark(s, t, a)) && event(Mark(s, t, b)) ==> a = b.

(* S0: sanity check: the command layer never reveals the abstract session key (the key is never sent, so this holds by construction; secrecy of the derived keys is shown in the full handshake models) *)
query s: bitstring, k: key; event(VKey(s, k)) && attacker(k) ==> false.
(* C1: injective agreement on each command (accepted at most once, only if sent in that session) *)
query s: bitstring, t: nat, m: bitstring; inj-event(Acc(s, t, m)) ==> inj-event(Send(s, t, m)).
(* C2: no command is accepted in a session other than the one in which it was sent *)
query s: bitstring, t: nat, m: bitstring; event(Acc(s, t, m)) ==> event(Send(s, t, m)).
(* R1: reachability check: the vehicle accepts a command whose counter is below the highest counter accepted before (a counterexample is the expected result and shows the rule accepts out of order) *)
query s: bitstring, t: nat, hi: nat; event(Late(s, t, hi)) ==> false.
(* R0: reachability check: the vehicle accepts at least one command (a counterexample is the expected result and shows that acceptance is reachable, so the proofs of C1 and C2 are not vacuous) *)
query s: bitstring, t: nat, m: bitstring; event(Acc(s, t, m)) ==> false.

(* Commands sent by the ground station under one key. *)
let GSCmds(sid: bitstring, k: key) =
  new m1: bitstring; event Send(sid, 1, m1); out(c, (tCmd, 1, m1, mac((tCmd, 1, m1), k)));
  new m2: bitstring; event Send(sid, 2, m2); out(c, (tCmd, 2, m2, mac((tCmd, 2, m2), k)));
  new m3: bitstring; event Send(sid, 3, m3); out(c, (tCmd, 3, m3, mac((tCmd, 3, m3), k)));
  new m4: bitstring; event Send(sid, 4, m4); out(c, (tCmd, 4, m4, mac((tCmd, 4, m4), k))).

(* Command acceptance at the vehicle under one key (the rule under test). *)
let VWin4(sid: bitstring, k: key, hi: nat, a1: nat, a2: nat, a3: nat) =
  in(c, (=tCmd, t: nat, m: bitstring, w: bitstring));
  if w = mac((tCmd, t, m), k) && t > 0 && t + 2 > hi && t <> a1 && t <> a2 && t <> a3 then
    (new st: stamp; event Mark(sid, t, st);
     if t > hi then (event Acc(sid, t, m); 0)
     else (event Late(sid, t, hi); event Acc(sid, t, m); 0))
  else 0.

let VWin3(sid: bitstring, k: key, hi: nat, a1: nat, a2: nat) =
  in(c, (=tCmd, t: nat, m: bitstring, w: bitstring));
  if w = mac((tCmd, t, m), k) && t > 0 && t + 2 > hi && t <> a1 && t <> a2 then
    (new st: stamp; event Mark(sid, t, st);
     if t > hi then (event Acc(sid, t, m); VWin4(sid, k, t, a1, a2, t))
     else (event Late(sid, t, hi); event Acc(sid, t, m); VWin4(sid, k, hi, a1, a2, t)))
  else VWin4(sid, k, hi, a1, a2, 0).

let VWin2(sid: bitstring, k: key, hi: nat, a1: nat) =
  in(c, (=tCmd, t: nat, m: bitstring, w: bitstring));
  if w = mac((tCmd, t, m), k) && t > 0 && t + 2 > hi && t <> a1 then
    (new st: stamp; event Mark(sid, t, st);
     if t > hi then (event Acc(sid, t, m); VWin3(sid, k, t, a1, t))
     else (event Late(sid, t, hi); event Acc(sid, t, m); VWin3(sid, k, hi, a1, t)))
  else VWin3(sid, k, hi, a1, 0).

let VWin1(sid: bitstring, k: key, hi: nat) =
  in(c, (=tCmd, t: nat, m: bitstring, w: bitstring));
  if w = mac((tCmd, t, m), k) && t > 0 && t + 2 > hi then
    (new st: stamp; event Mark(sid, t, st);
     if t > hi then (event Acc(sid, t, m); VWin2(sid, k, t, t))
     else (event Late(sid, t, hi); event Acc(sid, t, m); VWin2(sid, k, hi, t)))
  else VWin2(sid, k, hi, 0).

let VCmds(sid: bitstring, k: key) =
  VWin1(sid, k, 0).

process
  !(new k: key; new s: bitstring; (GSCmds(s, k) | (event VKey(s, k); VCmds(s, k))))
