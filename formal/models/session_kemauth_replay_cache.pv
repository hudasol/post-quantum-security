(* Model session_kemauth_replay_cache. Generated by formal/build_models.py; do not edit by hand.
   Design: design K, KEM authenticated hybrid session without signatures: the ground station and the vehicle each hold a static ML-KEM-768 key pair whose public key is pinned at the other side; F1 (ground to vehicle) carries an ephemeral X25519 share, an ephemeral ML-KEM-768 public key and a ciphertext to the vehicle static key; F2 (vehicle to ground) carries the vehicle X25519 share, a ciphertext to the ground ephemeral key, a ciphertext to the ground static key and the vehicle key confirmation tag; F3 carries the ground key confirmation tag; the session key is derived from the Diffie Hellman secret, the three KEM secrets and a hash of the transcript with both identities; MAVLink 2 signing tag with a sequence number under the derived key; rekey with fresh shares protected by the session key; commands accepted with the replay cache rule of session_replay_cache (table of accepted (session, counter) pairs that never forgets, lookup and insert in one indivisible step, encoded as a trace restriction); 3 commands per key, two keys per session, unbounded sessions and unbounded command messages at the vehicle
   Attacker setting: Dolev Yao attacker, no secret given *)

free c: channel.

type key.
type skey.
type pkey.
type expo.
type G.
type kemsk.
type kempk.
type coins.

(* Abstract signature (ML-DSA-44 in the architecture). *)
fun pk(skey): pkey.
fun sign(bitstring, skey): bitstring.
fun verify(bitstring, bitstring, pkey): bool
reduc forall m: bitstring, k: skey; verify(sign(m, k), m, pk(k)) = true.

(* Abstract classical Diffie Hellman group (X25519 in the architecture). *)
const g: G [data].
fun exp(G, expo): G.
equation forall x: expo, y: expo; exp(exp(g, x), y) = exp(exp(g, y), x).

(* Abstract KEM (ML-KEM-768 in the architecture), with implicit rejection: encapsulation with coins r
   gives a ciphertext and a shared secret; decapsulation with the matching
   secret key returns the same shared secret. *)
fun kpk(kemsk): kempk.
fun kct(kempk, coins): bitstring.
fun kss(kempk, coins): bitstring.
fun krej(kemsk, bitstring): bitstring [private].
fun decaps(kemsk, bitstring): bitstring
reduc forall sk: kemsk, r: coins; decaps(sk, kct(kpk(sk), r)) = kss(kpk(sk), r)
otherwise forall sk: kemsk, ct: bitstring; decaps(sk, ct) = krej(sk, ct).

(* Hash, key derivation over both secrets and the transcript hash, and a MAC
   (the MAVLink 2 signing tag, treated as a perfect MAC). *)
fun h(bitstring): bitstring.
fun kdf(G, bitstring, bitstring): key.
fun mac(bitstring, key): bitstring.

const tF1, tF2, tF3, tF4, tConfG, tConfV, tRk1, tRk2, tCmd: bitstring [data].
const idG, idV: bitstring [data].

event VRun(bitstring).
event GSKey(bitstring, key).
event GSAccept(bitstring, key).
event VAccept(bitstring, key).
event GSRekey(bitstring, key).
event VRekey(bitstring, key).
event Send(bitstring, nat, bitstring).
event Acc(bitstring, nat, bitstring).

(* S1: secrecy of the session key at the vehicle *)
query s: bitstring, k: key; event(VAccept(s, k)) && attacker(k) ==> false.
(* S2: secrecy of the session key at the ground station *)
query s: bitstring, k: key; event(GSAccept(s, k)) && attacker(k) ==> false.
(* S3: secrecy of the rekeyed session key at the vehicle *)
query s: bitstring, k: key; event(VRekey(s, k)) && attacker(k) ==> false.
(* S4: secrecy of the rekeyed session key at the ground station *)
query s: bitstring, k: key; event(GSRekey(s, k)) && attacker(k) ==> false.
(* A1: vehicle authenticates the ground station (injective agreement on the handshake) *)
query s: bitstring, k: key; inj-event(VAccept(s, k)) ==> inj-event(GSKey(s, k)).
(* C1: injective agreement on each command (accepted at most once, only if sent in that session) *)
query s: bitstring, t: nat, m: bitstring; inj-event(Acc(s, t, m)) ==> inj-event(Send(s, t, m)).
(* C2: no replay of a command into another session (across rekey, link outage and new handshake) *)
query s: bitstring, t: nat, m: bitstring; event(Acc(s, t, m)) ==> event(Send(s, t, m)).
(* R0: reachability check: the vehicle accepts at least one command (a counterexample is the expected result and shows that acceptance is reachable, so the proofs of C1 and C2 are not vacuous) *)
query s: bitstring, t: nat, m: bitstring; event(Acc(s, t, m)) ==> false.
(* RV: reachability check: the vehicle accepts a session key (a counterexample is the expected result and shows that the proofs of A1 and S1 are not vacuous) *)
query s: bitstring, k: key; event(VAccept(s, k)) ==> false.
(* RG: reachability check: the ground station accepts a session key (a counterexample is the expected result and shows that the proofs of A2 and S2 are not vacuous) *)
query s: bitstring, k: key; event(GSAccept(s, k)) ==> false.

type stamp.
event Mark(bitstring, nat, stamp).

(* Seen counter table, encoded as a restriction on traces (see session_replay_cache). *)
restriction s: bitstring, t: nat, a: stamp, b: stamp; event(Mark(s, t, a)) && event(Mark(s, t, b)) ==> a = b.

(* Commands sent by the ground station under one key. *)
let GSCmds(sid: bitstring, k: key) =
  new m1: bitstring; event Send(sid, 1, m1); out(c, (tCmd, 1, m1, mac((tCmd, 1, m1), k)));
  new m2: bitstring; event Send(sid, 2, m2); out(c, (tCmd, 2, m2, mac((tCmd, 2, m2), k)));
  new m3: bitstring; event Send(sid, 3, m3); out(c, (tCmd, 3, m3, mac((tCmd, 3, m3), k))).

(* Command acceptance at the vehicle under one key: the replay cache rule of session_replay_cache. *)
let VCmds(sid: bitstring, k: key) =
  !( in(c, (=tCmd, t: nat, m: bitstring, w: bitstring));
    if w = mac((tCmd, t, m), k) then
    new st: stamp; event Mark(sid, t, st);
    event Acc(sid, t, m) ).

(* Ground station: handshake of design K, commands under the session key, rekey with a fresh KEM,
   commands under the new key. *)
let GS(skKG: kemsk, pkKV: kempk) =
  new x: expo; new dk: kemsk; new r1: coins;
  let gx = exp(g, x) in
  let ek = kpk(dk) in
  let ct1 = kct(pkKV, r1) in
  
  out(c, (tF1, gx, ek, ct1));
  in(c, (=tF2, gy: G, ct2: bitstring, ct3: bitstring, cv: bitstring));
  let tr = (idG, idV, gx, ek, ct1, gy, ct2, ct3) in
  let sid = h(tr) in
  let k = kdf(exp(gy, x), (kss(pkKV, r1), decaps(dk, ct2), decaps(skKG, ct3)), sid) in
  event GSKey(sid, k);
  if cv = mac((tConfV, sid), k) then
  event GSAccept(sid, k);
  out(c, (tF3, mac((tConfG, sid), k)));
  new m1: bitstring; event Send(sid, 1, m1); out(c, (tCmd, 1, m1, mac((tCmd, 1, m1), k)));
  new m2: bitstring; event Send(sid, 2, m2); out(c, (tCmd, 2, m2, mac((tCmd, 2, m2), k)));
  new m3: bitstring; event Send(sid, 3, m3); out(c, (tCmd, 3, m3, mac((tCmd, 3, m3), k)));
  new x2: expo; new dk2: kemsk;
  let gx2 = exp(g, x2) in
  let ek2 = kpk(dk2) in
  out(c, (tRk1, gx2, ek2, mac((tRk1, gx2, ek2), k)));
  in(c, (=tRk2, gy2: G, ct4: bitstring, w2: bitstring));
  if w2 = mac((tRk2, gx2, ek2, gy2, ct4), k) then
  let sid2 = h((sid, gx2, ek2, gy2, ct4)) in
  let k2 = kdf(exp(gy2, x2), decaps(dk2, ct4), sid2) in
  event GSRekey(sid2, k2);
  GSCmds(sid2, k2).

(* Vehicle: handshake of design K; commands under the session key are accepted in parallel with the
   rekey; commands under the new key after it. *)
let V(skKV: kemsk, pkKG: kempk) =
  in(c, (=tF1, gx: G, ek: kempk, ct1: bitstring));
  new y[]: expo; new r2[]: coins; new r3[]: coins;
  let gy = exp(g, y) in
  let ct2 = kct(ek, r2) in
  let ct3 = kct(pkKG, r3) in
  
  let tr = (idG, idV, gx, ek, ct1, gy, ct2, ct3) in
  let sid = h(tr) in
  let k = kdf(exp(gx, y), (decaps(skKV, ct1), kss(ek, r2), kss(pkKG, r3)), sid) in
  event VRun(sid);
  out(c, (tF2, gy, ct2, ct3, mac((tConfV, sid), k)));
  in(c, (=tF3, cg: bitstring));
  if cg = mac((tConfG, sid), k) then
  event VAccept(sid, k);
  ( VCmds(sid, k)
  | in(c, (=tRk1, gx2: G, ek2: kempk, w: bitstring));
    if w = mac((tRk1, gx2, ek2), k) then
    new y2[]: expo; new r4[]: coins;
    let gy2 = exp(g, y2) in
    let ct4 = kct(ek2, r4) in
    out(c, (tRk2, gy2, ct4, mac((tRk2, gx2, ek2, gy2, ct4), k)));
    let sid2 = h((sid, gx2, ek2, gy2, ct4)) in
    let k2 = kdf(exp(gx2, y2), kss(ek2, r4), sid2) in
    event VRekey(sid2, k2);
    VCmds(sid2, k2) ).

process
  new skKG: kemsk; new skKV: kemsk;
  out(c, kpk(skKG)); out(c, kpk(skKV));
  ( (!GS(skKG, kpk(skKV))) | (!V(skKV, kpk(skKG))) )
