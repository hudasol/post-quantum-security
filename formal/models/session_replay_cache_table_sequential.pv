(* Model session_replay_cache_table_sequential. Generated by formal/build_models.py; do not edit by hand.
   Design: command layer only (abstract session key, as in session_timestamp_rule): replay cache written with ProVerif tables, the vehicle reads command messages one after the other and drops a message whose counter is in the table; 4 commands per key, at most 4 command messages read per key at the vehicle (attacker messages included), one key per session, unbounded sessions; used to record what the tool can and cannot prove with this encoding
   Attacker setting: Dolev Yao attacker, no secret given *)
free c: channel.
type key.
type stamp.
fun mac(bitstring, key): bitstring.
const tCmd: bitstring [data].
table seen(bitstring, nat).
event VKey(bitstring, key).
event Send(bitstring, nat, bitstring).
event Acc(bitstring, nat, bitstring).
event Mark(bitstring, nat, stamp).
event Late(bitstring, nat, nat).

(* No seen counter restriction in this model. *)

(* S0: sanity check: the command layer never reveals the abstract session key (the key is never sent, so this holds by construction; secrecy of the derived keys is shown in the full handshake models) *)
query s: bitstring, k: key; event(VKey(s, k)) && attacker(k) ==> false.
(* C1: injective agreement on each command (accepted at most once, only if sent in that session) *)
query s: bitstring, t: nat, m: bitstring; inj-event(Acc(s, t, m)) ==> inj-event(Send(s, t, m)).
(* C2: no command is accepted in a session other than the one in which it was sent *)
query s: bitstring, t: nat, m: bitstring; event(Acc(s, t, m)) ==> event(Send(s, t, m)).

(* Commands sent by the ground station under one key. *)
let GSCmds(sid: bitstring, k: key) =
  new m1: bitstring; event Send(sid, 1, m1); out(c, (tCmd, 1, m1, mac((tCmd, 1, m1), k)));
  new m2: bitstring; event Send(sid, 2, m2); out(c, (tCmd, 2, m2, mac((tCmd, 2, m2), k)));
  new m3: bitstring; event Send(sid, 3, m3); out(c, (tCmd, 3, m3, mac((tCmd, 3, m3), k)));
  new m4: bitstring; event Send(sid, 4, m4); out(c, (tCmd, 4, m4, mac((tCmd, 4, m4), k))).

(* Command acceptance at the vehicle under one key (the rule under test). *)
let VCmds4(sid: bitstring, k: key) =
  in(c, (=tCmd, t: nat, m: bitstring, w: bitstring));
  if w = mac((tCmd, t, m), k) then
    (get seen(=sid, =t) in 0 else insert seen(sid, t); event Acc(sid, t, m); 0)
  else 0.

let VCmds3(sid: bitstring, k: key) =
  in(c, (=tCmd, t: nat, m: bitstring, w: bitstring));
  if w = mac((tCmd, t, m), k) then
    (get seen(=sid, =t) in VCmds4(sid, k) else insert seen(sid, t); event Acc(sid, t, m); VCmds4(sid, k))
  else VCmds4(sid, k).

let VCmds2(sid: bitstring, k: key) =
  in(c, (=tCmd, t: nat, m: bitstring, w: bitstring));
  if w = mac((tCmd, t, m), k) then
    (get seen(=sid, =t) in VCmds3(sid, k) else insert seen(sid, t); event Acc(sid, t, m); VCmds3(sid, k))
  else VCmds3(sid, k).

let VCmds(sid: bitstring, k: key) =
  in(c, (=tCmd, t: nat, m: bitstring, w: bitstring));
  if w = mac((tCmd, t, m), k) then
    (get seen(=sid, =t) in VCmds2(sid, k) else insert seen(sid, t); event Acc(sid, t, m); VCmds2(sid, k))
  else VCmds2(sid, k).

process
  !(new k: key; new s: bitstring; (GSCmds(s, k) | (event VKey(s, k); VCmds(s, k))))
